# cp .env.example .env して使う。.env はコミットしないこと。

# --- DB ---
DATABASE_URL=postgres://app:password@db:5432/menu_planner?sslmode=disable

# --- 認証 ---
# openssl rand -base64 32 で生成した値に置き換えること
JWT_SECRET=dev-only-secret-do-not-use-in-production

# Google Cloud Console の OAuth 2.0 クライアントIDから取得する。
# 空のままでもメール/パスワード認証は動作する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# --- レシピ検索API ---
# stub にするとAPIキー無しでダミーのレシピを返す（開発・CI用）
# brave | stub （spec.md 13.1 で Brave に決定。google_cse は新規申込が締め切られ廃止）
SEARCH_API_PROVIDER=stub
# Brave Search API のキー。https://api-dashboard.search.brave.com/ で取得する。
# SEARCH_API_PROVIDER=stub のままなら空でよい。
SEARCH_API_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- レート制限（IP/分。0で無制限） ---
# Vite プロキシ配下では全リクエストが単一IPに集約されるため、開発では 0 で切る。
# 本番は実クライアントIPが分かる構成で spec 値（認証10 / 検索60）を設定する。
AUTH_RATE_LIMIT_PER_MIN=0
SEARCH_RATE_LIMIT_PER_MIN=0
